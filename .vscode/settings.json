{
  "qt.qml.importPaths": [
    "/opt/homebrew/share/qt/qml",
    "${workspaceFolder}/build",
    "${workspaceFolder}/build/QuickCart",
    "${workspaceFolder}/qml"
  ],
  "qmlls.customPath": "/opt/homebrew/bin/qmlls",
  "qmlls.buildDir": "${workspaceFolder}/build",
  "C_Cpp.default.compileCommands": "${workspaceFolder}/compile_commands.json",
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}"
  ]
}
