# LeakSanitizer (LSan) Suppression File for QuickCart CI
# Suppresses known memory leaks inside third-party system shared libraries only
# DO NOT suppress QuickCart application namespaces (QuickCart, core, api, models, security)

# 1. System Font and Typography libraries (fontconfig, freetype)
leak:libfontconfig
leak:libfreetype
leak:FcConfig*
leak:FcPattern*
leak:FcFont*

# 2. X11, Wayland, and XCB windowing system drivers
leak:libX11
leak:libxcb
leak:_Xlc*
leak:Xcursor*
leak:libxkbcommon

# 3. Mesa and OpenGL / Vulkan GPU drivers
leak:libGLX
leak:libGL
leak:libEGL
leak:libLLVM
leak:iris_dri.so
leak:swrast_dri.so

# 4. D-Bus and Glib event loops
leak:libdbus-1
leak:libglib-2.0
leak:g_main_context*
leak:dbus_bus_get_private

# 5. Glibc dynamic loader and TLS initializers
leak:_dl_init
leak:_dl_catch_exception
leak:call_init



